# Modelo de variáveis. Em desenvolvimento copie para .env.local;
# na Hostinger, cadastre cada uma em "Variáveis de ambiente" do app Node.js.

# Endereço público do painel (sem barra no final)
APP_URL=https://seu-dominio.com.br

# Banco MySQL. Na Hostinger o host é "localhost".
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
# Alternativa em uma linha (codifique caracteres especiais da senha, ex.: @ vira %40):
# DATABASE_URL=mysql://usuario:senha@localhost:3306/banco

# Chave AES-256 em base64 (32 bytes). Protege os segredos do 2FA e das integrações.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Guarde em lugar seguro e NUNCA troque depois de em uso.
ENCRYPTION_KEY=

# Primeiro administrador: criado só quando não existe nenhum usuário.
# 10+ caracteres com letras e números; será trocada no primeiro acesso.
ADMIN_NAME=Marcos
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Dados de exemplo enquanto o YouTube não está conectado (true/false)
DEMO_DATA=false

# Token que o Evolution envia na URL do webhook (?token=...)
EVOLUTION_WEBHOOK_TOKEN=

# Opcional: o Evolution e o Gemini também podem ser configurados pelo painel (Integrações)
EVOLUTION_URL=
EVOLUTION_INSTANCE=
EVOLUTION_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Opcionais
# AUTO_MIGRATE=true   # cria/atualiza as tabelas ao iniciar
# SCHEDULER=true      # liga os envios automáticos (alertas e resumos)
# DB_POOL_SIZE=5      # conexões simultâneas com o MySQL

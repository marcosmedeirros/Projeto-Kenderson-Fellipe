# HTTPS automático (Let's Encrypt). Aponte o DNS dos domínios para o IP da VM
# e libere as portas 80 e 443 na Security List da Oracle e no firewall da VM.

{$PAINEL_DOMINIO} {
	encode zstd gzip
	request_body {
		max_size 2MB
	}
	reverse_proxy painel:3000
}


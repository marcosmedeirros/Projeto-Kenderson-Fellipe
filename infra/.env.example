# Copie para infra/.env no servidor. NUNCA commite o .env.

# Domínios (DNS apontando para o IP da VM)
PAINEL_DOMINIO=painel.seudominio.com.br
EVOLUTION_DOMINIO=

# Postgres. Gere com: openssl rand -base64 24
POSTGRES_PASSWORD=

# Chave AES-256 (base64, 32 bytes). Gere com: openssl rand -base64 32
# Guarde em lugar seguro: sem ela, os segredos do 2FA e das integrações não podem ser lidos.
ENCRYPTION_KEY=

# Primeiro administrador (criado só se o banco estiver vazio; troca a senha no primeiro acesso)
ADMIN_NAME=Marcos
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Token do webhook do Evolution. Gere com: openssl rand -base64 24
EVOLUTION_WEBHOOK_TOKEN=

# Só se usar o Evolution deste compose
EVOLUTION_API_KEY=

# Enquanto o YouTube não estiver conectado, dá para mostrar dados de exemplo
DEMO_DATA=false

# Copie para .env.local (desenvolvimento) ou configure no servidor (produção).

# Postgres. Vazio em desenvolvimento = banco embutido (PGlite) em .data/pglite
DATABASE_URL=postgres://controladoria:SENHA@postgres:5432/controladoria

# Chave AES-256 em base64 (32 bytes). Protege os segredos do 2FA e das integrações.
# Gere com: openssl rand -base64 32   (NUNCA troque depois de em uso)
ENCRYPTION_KEY=

# Primeiro administrador: criado só quando não existe nenhum usuário.
# A senha precisa ter 10+ caracteres com letras e números e será trocada no primeiro acesso.
ADMIN_NAME=Marcos
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Dados de exemplo enquanto o YouTube não está conectado (true/false)
DEMO_DATA=false

# Token que o Evolution envia na URL do webhook (?token=...). Gere com: openssl rand -base64 24
EVOLUTION_WEBHOOK_TOKEN=

# Opcional: o Evolution também pode ser configurado pelo painel (Integrações)
EVOLUTION_URL=
EVOLUTION_INSTANCE=
EVOLUTION_API_KEY=

# Opcional: o Gemini também pode ser configurado pelo painel (Integrações)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Opcionais
# AUTO_MIGRATE=true   # aplica as migrações do banco ao iniciar
# SCHEDULER=true      # liga os envios automáticos (alertas e resumos)
